# ============================================================
# SENPAI DEN — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# Each variable below indicates WHERE to obtain it.
# ============================================================


# ============================================================
# SUPABASE — Database & Backend
# Source: https://app.supabase.com → Your Project → Settings → API
# ============================================================

# Your Supabase project's REST API URL
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase anon/public key — safe for client-side use (read-only with RLS)
# Found in: Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=

# Supabase service role key — NEVER expose client-side, grants full DB access
# Used by: GitHub Actions scraper, Hugging Face worker, Cloudflare Worker
# Found in: Settings → API → Project API keys → service_role
SUPABASE_SERVICE_KEY=

# Next.js public URL (can use anon key for frontend data fetching via Edge Worker)
# This is the Cloudflare Worker URL, not Supabase directly
NEXT_PUBLIC_API_URL=


# ============================================================
# CLOUDFLARE R2 — Object Storage (Image CDN)
# Source: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
# ============================================================

# Your Cloudflare Account ID (not zone ID)
# Found in: Cloudflare Dashboard → Right sidebar → Account ID
R2_ACCOUNT_ID=

# R2 S3-compatible API endpoint
# Format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# R2 API token with Object Read & Write permissions
# Generate at: R2 → Manage R2 API Tokens → Create API Token
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Name of your R2 bucket (create at: R2 → Create Bucket)
R2_BUCKET_NAME=manga-images

# Public URL for serving R2 images via Cloudflare CDN
# Enable at: R2 Bucket → Settings → Public Access → Allow Access
# Format: https://pub-<hash>.r2.dev OR your custom domain
R2_PUBLIC_URL=


# ============================================================
# CLOUDFLARE WORKERS — Edge API Gateway
# Source: https://dash.cloudflare.com → Workers & Pages
# ============================================================

# Your deployed Cloudflare Worker URL
# Format: https://<worker-name>.<subdomain>.workers.dev
# Set via wrangler: `npx wrangler secret put SUPABASE_SERVICE_KEY`
CLOUDFLARE_WORKER_URL=

# Cloudflare API Token for Wrangler deployments (CI/CD)
# Generate at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Workers Scripts → Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare Account ID (same as R2_ACCOUNT_ID, duplicated for clarity)
CLOUDFLARE_ACCOUNT_ID=


# ============================================================
# HUGGING FACE — Worker Space (Image Processing)
# Source: https://huggingface.co/settings/tokens
# ============================================================

# Hugging Face API token with write access to your Space
# Generate at: Settings → Access Tokens → New Token (role: write)
HF_TOKEN=

# Your Hugging Face username
HF_USERNAME=

# Name of your Hugging Face Space
# Full Space ID will be: <HF_USERNAME>/<HF_SPACE_NAME>
HF_SPACE_NAME=senpai-den-worker

# Port the HF worker server listens on (HF Spaces expose port 7860 by default)
HF_WORKER_PORT=7860


# ============================================================
# MANGA PROVIDER APIS — Data Sources
# Source: Self-hosted or public API endpoints (see architecture.md)
# ============================================================

# FireFly Manga API base URL (your self-hosted or public instance)
# From: https://github.com/<firefly-repo> — deploy to Railway/Render free tier
FIREFLY_API_BASE_URL=

# FireFly API key (if the instance requires one, otherwise leave blank)
FIREFLY_API_KEY=

# MangaHook API base URL (your self-hosted or public instance)
# From: https://github.com/<mangahook-repo>
MANGAHOOK_API_BASE_URL=

# MangaHook API key (if required)
MANGAHOOK_API_KEY=


# ============================================================
# GITHUB ACTIONS — CI/CD Secrets (set via GitHub repository secrets)
# Source: GitHub Repo → Settings → Secrets and variables → Actions
# NOTE: Do NOT put these in .env for GitHub Actions.
#       Add them as Repository Secrets in GitHub UI instead.
#       Listed here for documentation purposes only.
# ============================================================

# These map to GitHub Actions secrets:
# SUPABASE_URL         → same as above
# SUPABASE_SERVICE_KEY → same as above
# R2_ACCOUNT_ID        → same as above
# R2_ACCESS_KEY_ID     → same as above
# R2_SECRET_ACCESS_KEY → same as above
# R2_BUCKET_NAME       → same as above
# FIREFLY_API_KEY      → same as above
# MANGAHOOK_API_KEY    → same as above


# ============================================================
# APPLICATION CONFIG — Tuning & Operational Parameters
# These have safe defaults; change only if you understand the impact
# ============================================================

# Max requests per GitHub Actions scraper run per provider
# Default: 100 (per AD-005 architecture decision)
MAX_REQUESTS_PER_RUN=100

# Request throttle delay in milliseconds (500ms = 2 req/s)
# Default: 500 (per AD-005)
REQUEST_DELAY_MS=500

# Manhwa slice height in pixels
# Default: 1500 (per AD-003)
SLICE_HEIGHT_PX=1500

# WebP image quality (0-100)
# Default: 70 (good quality/size balance)
WEBP_QUALITY=70

# Chapter processing hard timeout in seconds
# Default: 300 (5 minutes, per AD-002)
MAX_PROCESSING_TIME_SECONDS=300

# DLQ retry base delay in milliseconds
# Retry delays: BASE, BASE×2, BASE×4
# Default: 30000 (30 seconds)
DLQ_RETRY_BASE_DELAY_MS=30000

# Max DLQ retry attempts before permanent failure
# Default: 3
DLQ_MAX_RETRIES=3

# Image eviction retention period in days
# Default: 30 (per AD-004)
IMAGE_RETENTION_DAYS=30

# Provider blackout stale retry interval in minutes
# Default: 30 (retry stale chapters every 30 minutes)
STALE_RETRY_INTERVAL_MINUTES=30

# Provider blackout max retry duration in hours (after this → ARCHIVED)
# Default: 24 (per AD-001)
STALE_MAX_RETRY_HOURS=24

# Node environment
NODE_ENV=development
